# Crypto Screener V2
# Copy to .env and fill in your values

# Bybit API
CS_BYBIT_API_KEY=your_api_key
CS_BYBIT_API_SECRET=your_api_secret

# Telegram
CS_TELEGRAM_TOKEN=your_bot_token
CS_TELEGRAM_CHAT_ID=your_chat_id

# SOCKS5 proxy for Telegram (optional)
CS_TG_PROXY=socks5://127.0.0.1:10808

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
