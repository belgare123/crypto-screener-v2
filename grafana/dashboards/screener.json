{
  "title": "Crypto Screener V2",
  "uid": "screener",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "title": "Signals Rate (5m)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(signals_total[5m])",
          "legendFormat": "{{signal}} — {{symbol}}"
        }
      ]
    },
    {
      "title": "Total Signals",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(signals_total)"
        }
      ],
      "description": "Total signals generated by engine"
    },
    {
      "title": "Blocked by Filter",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "sum(signals_blocked)"
        }
      ],
      "description": "Signals blocked (min_score / cooldown)"
    },
    {
      "title": "Signal Errors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [
        {
          "expr": "sum(signal_errors)"
        }
      ],
      "description": "Signal handler crashes"
    },
    {
      "title": "Dispatched Signals Rate (5m)",
      "type": "graph",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(dispatched_signals[5m])"
        }
      ],
      "description": "Signals actually sent to Telegram"
    },
    {
      "title": "Blocked by Reason",
      "type": "piechart",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum by(reason) (signals_blocked)"
        }
      ],
      "description": "Why signals were blocked"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "symbol",
        "type": "query",
        "query": "label_values(signals_total, symbol)"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Signal",
        "datasource": "Prometheus",
        "expr": "rate(signals_total[1m]) > 0",
        "enable": true
      }
    ]
  }
}
